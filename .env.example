# --- required ---

# Neon Postgres pooled connection string.
# Neon dashboard -> Connection Details -> the "postgresql://...-pooler..." URL.
DATABASE_URL=

# 32+ random characters. Encrypts the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The one address that bootstraps the owner account + the family tree
# on first login. Everyone else joins by invitation.
OWNER_EMAIL=

# Public base URL, used in the links inside login / invitation emails.
APP_URL=http://localhost:3000

# --- optional ---

# Transactional email. Without it, magic-link and invite URLs are printed
# to the server console instead of sent (fine for local dev).
RESEND_API_KEY=
EMAIL_FROM="Mizizi <onboarding@resend.dev>"
