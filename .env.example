# --- required ---

# Neon Postgres pooled connection string
# Neon dashboard -> Connection Details -> the "postgresql://...-pooler..." URL
DATABASE_URL=

# Auth.js session secret. 32+ random chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The one address that becomes the tree owner on first sign-in.
# Everyone else who signs in is a viewer until the owner promotes them.
OWNER_EMAIL=

# Public base URL (used for invitation links shown in /admin)
APP_URL=http://localhost:3000

# --- OAuth providers (create a free app for each; steps in README) ---

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
# Authorized redirect URI:  <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Meta for Developers -> your app -> Facebook Login -> Settings
# Valid OAuth Redirect URI:  <APP_URL>/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# --- optional ---

# Transactional email (password-reset links). Without it, reset links are
# printed to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Mizizi <onboarding@resend.dev>"
